# Copy to .env and fill in real values. NEVER commit the real .env.
# In production (Streamlit Community Cloud), set these in the Secrets manager instead.

# Required:
ANTHROPIC_API_KEY=your_key_here
GOOGLE_PLACES_API_KEY=your_key_here

# Optional (the agent skips these data sources if unset):
YELP_API_KEY=your_key_here
TICKETMASTER_API_KEY=your_key_here

# Optional: set this to password-protect a public demo (limits API-cost abuse).
APP_PASSWORD=your_password_here
